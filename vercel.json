{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/shop/:path*",
      "destination": "/pages/shop/:path*"
    },
    {
      "source": "/info/:path*",
      "destination": "/pages/info/:path*"
    },
    {
      "source": "/account/:path*",
      "destination": "/pages/account/:path*"
    }
  ]
}