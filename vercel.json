{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/shop/(.*)",
      "destination": "/pages/shop/$1"
    },
    {
      "source": "/info/(.*)",
      "destination": "/pages/info/$1"
    },
    {
      "source": "/account/(.*)",
      "destination": "/pages/account/$1"
    },
    {
      "source": "/([a-zA-Z0-9-]+)",
      "destination": "/pages/shop/product-detail.html"
    }
  ]
}