{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/shop/:match*",
      "destination": "/pages/shop/:match*"
    },
    {
      "source": "/info/:match*",
      "destination": "/pages/info/:match*"
    },
    {
      "source": "/account/:match*",
      "destination": "/pages/account/:match*"
    },
    {
      "source": "/:slug([a-zA-Z0-9-]+)",
      "destination": "/pages/shop/product-detail"
    }
  ]
}